// ============================================================
// fir_filter_stream.v
// FIR Filter for audio (streaming, sample-enable)
// - One-multiply-per-cycle MAC engine (resource-friendly)
// - Accepts new input sample only when sample_en=1 (e.g., LRCK-edge strobe)
// - Outputs y with a one-cycle valid pulse (dataOut_valid)
//
// Coefficients:
//   - Stored in ROM 'h[]' and initialized via $readmemh(COEFF_FILE)
//
// Fixed-point conventions:
//   - dataIn/dataOut are signed DATA_W (default 24-bit)
//   - coefficients are signed COEF_W in Q1.(COEF_W-1) (default Q1.17 if COEF_W=18)
//   - Multiply accumulates sum(x[k]*h[k]) then arithmetic shift right (COEF_W-1)
//   - Rounding + saturation back to DATA_W
// ============================================================

module fir_filter_stream #(
    parameter integer DATA_W     = 24,
    parameter integer COEF_W     = 18,
    parameter integer NTAPS      = 127,
    parameter        COEFF_FILE  = "fir_coeffs.mem"   // hex signed words, one per line
)(
    input  wire                     clk,          // e.g., 50 MHz
    input  wire                     rst_n,        // active-low reset
    input  wire                     sample_en,    // 1 clk pulse when a NEW sample arrives
    input  wire signed [DATA_W-1:0] dataIn,       // signed PCM sample
    output reg  signed [DATA_W-1:0] dataOut,      // filtered sample
    output reg                      dataOut_valid // 1 clk pulse when dataOut updates
);

    // ----------------------------
    // Coefficient ROM
    // ----------------------------
    reg signed [COEF_W-1:0] h [0:NTAPS-1];

    integer ii;
    initial begin
        for (ii = 0; ii < NTAPS; ii = ii + 1)
            h[ii] = {COEF_W{1'b0}};
        $readmemh(COEFF_FILE, h);
    end

    // ----------------------------
    // Sample shift register
    // x[0] = newest
    // ----------------------------
    reg signed [DATA_W-1:0] x [0:NTAPS-1];

    // ----------------------------
    // MAC engine
    // ----------------------------
    localparam integer ACC_W  = DATA_W + COEF_W + 8;
    localparam integer SHIFT  = (COEF_W - 1);

    reg signed [ACC_W-1:0] acc;
    reg [15:0] tap_idx;

    localparam [1:0] S_IDLE = 2'd0,
                     S_MAC  = 2'd1,
                     S_DONE = 2'd2;

    reg [1:0] state;

    // Saturation helper to DATA_W signed
    function [DATA_W-1:0] sat_dataw;
        input signed [ACC_W-1:0] v;
        reg signed [ACC_W-1:0] vmax, vmin;
        begin
            vmax = ( (1<<<(DATA_W-1)) - 1 );
            vmin = ( - (1<<<(DATA_W-1)) );

            if (v > vmax)      sat_dataw = {1'b0, {(DATA_W-1){1'b1}}};
            else if (v < vmin) sat_dataw = {1'b1, {(DATA_W-1){1'b0}}};
            else               sat_dataw = v[DATA_W-1:0];
        end
    endfunction

    // Rounding before shift-right
    function signed [ACC_W-1:0] round_shift;
        input signed [ACC_W-1:0] v;
        input integer sh;
        reg signed [ACC_W-1:0] half;
        begin
            if (sh <= 0) begin
                round_shift = v;
            end else begin
                half = ({{(ACC_W-1){1'b0}},1'b1} <<< (sh-1));
                round_shift = (v >= 0) ? (v + half) : (v - half);
            end
        end
    endfunction

    // Shift register update on new sample
    integer k;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            for (k = 0; k < NTAPS; k = k + 1)
                x[k] <= {DATA_W{1'b0}};
        end else if (sample_en) begin
            x[0] <= dataIn;
            for (k = 1; k < NTAPS; k = k + 1)
                x[k] <= x[k-1];
        end
    end

    // MAC state machine
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state         <= S_IDLE;
            tap_idx       <= 16'd0;
            acc           <= {ACC_W{1'b0}};
            dataOut       <= {DATA_W{1'b0}};
            dataOut_valid <= 1'b0;
        end else begin
            dataOut_valid <= 1'b0; // default pulse low

            case (state)
                S_IDLE: begin
                    if (sample_en) begin
                        tap_idx <= 16'd0;
                        acc     <= {ACC_W{1'b0}};
                        state   <= S_MAC;
                    end
                end

                S_MAC: begin
                    acc <= acc + ($signed(x[tap_idx]) * $signed(h[tap_idx]));

                    if (tap_idx == NTAPS-1) begin
                        state <= S_DONE;
                    end else begin
                        tap_idx <= tap_idx + 16'd1;
                    end
                end

                S_DONE: begin : OUT_BLOCK
                    reg signed [ACC_W-1:0] acc_r;
                    reg signed [ACC_W-1:0] y_s;

                    acc_r = round_shift(acc, SHIFT);
                    y_s   = acc_r >>> SHIFT;

                    dataOut <= $signed(sat_dataw(y_s));
                    dataOut_valid <= 1'b1;
                    state <= S_IDLE;
                end

                default: state <= S_IDLE;
            endcase
        end
    end

endmodule
